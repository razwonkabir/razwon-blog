rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && isEmailVerified() && (
        request.auth.token.email in [
          'inbox@razwon.xyz',
          'razwon2009@gmail.com',
          'sew123ty@gmail.com',
          'apnosmedia2022@gmail.com'
        ]
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // BlogPost validation helper
    function isValidBlogPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 500
          && data.summary is string && data.summary.size() <= 1000
          && data.content is string && data.content.size() <= 50000
          && data.tags is list && data.tags.size() <= 20
          && data.categories is list && data.categories.size() <= 10
          && data.author is string && data.author.size() <= 100
          && data.readTime is string && data.readTime.size() <= 50;
    }

    // Subscription validation helper
    function isValidSubscription(data) {
      return data.email is string && data.email.size() <= 256
          && data.subscribedAt is number
          && data.source is string && data.source.size() <= 100;
    }

    // Rules for posts
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;

      // Only admins can create posts
      allow create: if isAdmin() && isValidBlogPost(incoming());

      // Only admins can delete posts
      allow delete: if isAdmin();

      // Updates are allowed if:
      // 1. User is admin and saving valid blog post data
      // 2. Or, any user is incrementing views count (public views increment)
      allow update: if (
        (isAdmin() && isValidBlogPost(incoming())) ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
          (existing().views == null || incoming().views == existing().views + 1)
        )
      );
    }

    // Rules for newsletter subscriptions
    match /subscriptions/{subId} {
      // Anyone can query subscriptions (to verify existence) or get specific document
      allow read: if true;

      // Anyone can create a new subscription
      allow create: if isValidSubscription(incoming());

      // Only admins can delete or update subscriptions
      allow update, delete: if isAdmin();
    }
  }
}
